# dev_mount sdcard /mnt/sdcard auto /devices/platform/msm_sdcc.2/mmc_host

# SD interna — Almacenamiento interno del sistema
# dev_mount sdcard2 /mnt/sdcard2 auto /devices/platform/msm_sdcc.3/mmc_host

